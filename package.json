    "@opentelemetry/resources": "^2.0.1",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.34.0",
    "axios": "^1.6.0",
    "bunyan": "^1.8.15",
    "compression": "^1.7.4",
    "dotenv": "^16.0.2",
    "ejs": "^3.1.8",
    "express": "^4.18.1",
    "form-data": "^4.0.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.0",
    "mongo-sanitize": "^1.1.0",
    "mongoose": "^7.6.6",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-datetime": "^2.1.2",
    "opencage-api-client": "^1.0.4",
    "redis": "^4.7.0",
